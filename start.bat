@echo off
chcp 65001
title Запуск приложения "Колесо и поршень"

echo ========================================
echo    Запуск приложения "Колесо и поршень"
echo ========================================
echo.

:: ========================================
:: 1. НАСТРОЙКА И ЗАПУСК СЕРВЕРА (BACKEND)
:: ========================================
echo [1/4] Настройка сервера...
echo.

:: Переход в папку сервера
cd backend\WebApi\WebApi

:: Установка dotnet-ef (если не установлен)
echo Проверка установки dotnet-ef...
dotnet tool list --global | findstr "dotnet-ef" > nul
if errorlevel 1 (
    echo Установка dotnet-ef...
    dotnet tool install --global dotnet-ef
    echo dotnet-ef успешно установлен!
) else (
    echo dotnet-ef уже установлен.
)
echo.

:: Применение миграций к базе данных
echo Применение миграций к базе данных...
dotnet ef database update
if errorlevel 1 (
    echo Ошибка при обновлении базы данных!
    pause
    exit /b 1
)
echo Миграции успешно применены!
echo.

:: Запуск сервера в отдельном окне
echo Запуск сервера...
start "Сервер" cmd /k "title Сервер && echo Сервер запускается... && dotnet run"
echo Сервер запущен в отдельном окне.
echo.

:: Возвращаемся в корневую папку
cd ..\..\..

:: ========================================
:: 2. НАСТРОЙКА И ЗАПУСК КЛИЕНТА (FRONTEND)
:: ========================================
echo [2/4] Настройка клиента...
echo.

:: Переход в папку клиента
cd frontend\client

:: Установка зависимостей npm (если node_modules не существует)
if not exist "node_modules" (
    echo Установка зависимостей npm...
    npm install
    if errorlevel 1 (
        echo Ошибка при установке зависимостей!
        pause
        exit /b 1
    )
    echo Зависимости успешно установлены!
) else (
    echo Зависимости уже установлены.
)
echo.

:: Запуск клиента в отдельном окне
echo Запуск клиента...
start "Клиент" cmd /k "title Клиент && echo Клиент запускается... && npm start"
echo Клиент запущен в отдельном окне.
echo.

:: Возвращаемся в корневую папку
cd ..\..

:: ========================================
:: 3. ЗАВЕРШЕНИЕ
:: ========================================
echo [3/3] Запуск завершен!
echo.
echo ========================================
echo    Сервер и клиент запущены!
echo    Клиент: http://localhost:3000
echo    Сервер: http://localhost:5027
echo ========================================
echo.
echo Закройте это окно, чтобы завершить работу.
echo Для остановки сервера/клиента закройте их окна.
echo.

pause